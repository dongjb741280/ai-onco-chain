# LLM（LangChain Anthropic 侧）
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# 指南 RAG embedding（本地多语言向量模型 bge-m3，支持中英跨语言检索；无需 API key；下载失败自动退回 BM25）
EMBEDDING_MODEL=BAAI/bge-m3
HF_ENDPOINT=https://hf-mirror.com   # HuggingFace 国内镜像（模型下载用）
HF_HUB_DISABLE_XET=1                 # 关闭 xet 加速（国内网络下更稳）

# 检索参数
GUIDE_RETRIEVER=auto        # auto | vector | bm25
GUIDE_TOP_K=6

# 多轮记忆：图状态持久化到 Postgres（可选；留空则退回内存 checkpointer）
POSTGRES_URL=postgresql://user:pass@localhost:5432/breast_cancer
