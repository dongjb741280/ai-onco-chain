# macOS
.DS_Store

# IDE
.vscode/

# 向量库（生成物，需 API key 重新生成）
knowledge_base/chroma/

# Python
__pycache__/
*.py[cod]
.venv/

# Rendered page images (regenerable via pdftoppm)
pages_csco/
pages_caca/

# Compiled OCR binary (rebuild with `swiftc -O ocr.swift -o ocr`)
Data_Cleaning/process/ocr

# Patient case data + source PDFs (de-identified but kept out of the public repo)
Data_Cleaning/doc/
.gstack/

# Env secrets（真实 key 不入库，模板见 langgraph_diagnosis/.env.example）
.env

# 诊断报告生成物（含患者派生临床内容，不入库）
langgraph_diagnosis/reports/

# 向量索引缓存（embedding 落盘，可重建）
langgraph_diagnosis/.cache/

# Node / Vite 前端
langgraph_diagnosis/web/node_modules/
langgraph_diagnosis/web/dist/
